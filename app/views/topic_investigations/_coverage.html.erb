<section class="mb-6 border border-line rounded-xl p-5" data-topic-coverage data-complete="<%= coverage['complete'] %>">
  <h2 class="font-bold"><%= t("topics.coverage.heading") %></h2>
  <% if @topic.completed? && !coverage["complete"] %><p role="status" class="my-3" data-partial-result><%= t("topics.coverage.partial") %></p><% end %>
  <% if coverage["requested"] %><p><%= t("topics.coverage.requested", count: coverage["requested"]) %></p><% end %>
  <p><%= t("topics.coverage.counts", selected: coverage["selected"], analyzed: coverage["analyzed"], pending: coverage["pending"], failed: coverage["failed"], unread: coverage["unread"]) %></p>
  <% coverage["editorial_quotas"].each do |side, quota| %>
    <% next unless quota["requested"].positive? %>
    <p><%= t("topics.coverage.quota", side: t("topics.sides.#{side}"), requested: quota["requested"], selected: quota["selected"], analyzed: quota["analyzed"], missing: quota["missing"]) %></p>
  <% end %>
  <ul class="mt-3 space-y-2">
    <% coverage["sources"].each do |source| %>
      <li data-analysis-source="<%= source['source_id'] %>">
        <%= source["title"] %> — <%= t("topics.coverage.statuses.#{source['status']}") %>
        <% if source["analysis_slug"].present? %><%= link_to t("topics.full_report"), investigation_path(source["analysis_slug"]), class: "underline" %><% end %>
        <% if source["error_code"].present? %><span><%= t("topics.errors.analysis_incomplete") %></span><% end %>
      </li>
    <% end %>
  </ul>
</section>

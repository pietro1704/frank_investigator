<%= form_with url: topic_investigations_path, method: :post, local: true, class: "mt-6" do |form| %>
  <%= form.label :question, t("topics.form.label"), for: "topic-question", class: "block text-sm font-bold" %>
  <p class="mt-2 text-sm text-muted"><%= t("topics.form.help") %></p>
  <%= form.text_area :question, id: "topic-question", value: question, required: true, maxlength: Investigations::TopicDiscovery::MAX_QUESTION_LENGTH, rows: 2, placeholder: t("topics.form.placeholder"), class: "mt-3 block w-full min-h-14 px-5 py-3 border border-line rounded-2xl bg-white text-ink" %>
  <%= form.submit t("topics.form.submit"), class: "mt-3 px-6 py-3 rounded-2xl bg-ink text-white cursor-pointer font-semibold" %>
<% end %>

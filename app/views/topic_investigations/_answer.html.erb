<section class="mb-8 space-y-5" data-topic-answer>
  <p class="text-sm text-muted"><%= local_assigns.fetch(:scope, @topic.report["scope"]) %></p>
  <% answer.each do |group, points| %>
    <section data-answer-group="<%= group %>">
      <h2 class="font-serif text-2xl font-bold mb-3"><%= t("topics.answer.#{group}") %></h2>
      <% if points.empty? %><p class="text-muted"><%= t("topics.answer.empty_#{group}") %></p><% end %>
      <% points.each do |point| %>
        <div class="mb-4 border-l-4 border-line pl-4" data-answer-point="<%= point['id'] %>">
          <p class="font-semibold"><%= point["claim"] %></p>
          <p><%= point["conclusion"] %></p>
          <% point["limitations"].each do |text| %><p class="text-sm text-muted"><%= text %></p><% end %>
          <ul class="mt-2 space-y-2 text-sm">
            <% point["citations"].each do |source| %>
              <li><% if (url = topic_source_url(source["url"])) %><%= link_to source["title"], url, target: "_blank", rel: "noopener noreferrer", class: "underline" %><% else %><%= source["title"] %><% end %>
                <blockquote><%= source["quote"] %></blockquote>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </section>
  <% end %>
  <ul class="list-disc pl-5 text-sm text-muted"><% Array(local_assigns.fetch(:limitations, @topic.report["limitations"])).each do |text| %><li><%= text %></li><% end %></ul>
</section>

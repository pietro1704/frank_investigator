<% content_for :title, t("topics.heading") %>
<main class="w-full max-w-[800px] mx-auto px-4 py-8">
  <p class="mb-6 underline"><%= link_to t("topics.home"), root_path %></p>
  <h1 class="font-serif text-3xl font-bold"><%= t("topics.heading") %></h1>
  <%= render "form", question: @question %>
  <% if @error %><p class="mt-4 text-verdict-red" role="alert"><%= @error %></p><% end %>
</main>

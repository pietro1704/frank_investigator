<%= form_with url: question_search_path, method: :get, local: true, class: "mt-6" do |form| %>
  <%= form.label :question, t("questions.form.label"), class: "block text-sm font-bold" %>
  <%= form.search_field :question, value: question, required: true, maxlength: Investigations::QuestionSearch::MAX_LENGTH, placeholder: t("questions.form.placeholder"), class: "mt-3 block w-full min-h-14 px-5 py-3 border border-line rounded-2xl bg-white text-ink" %>
  <%= form.submit t("questions.form.submit"), class: "mt-3 px-6 py-3 rounded-2xl bg-ink text-white cursor-pointer font-semibold" %>
<% end %>
